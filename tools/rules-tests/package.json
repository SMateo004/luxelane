  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1",
    "jest": "29.7.0",
    "ts-jest": "29.4.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "22"
  }
}
