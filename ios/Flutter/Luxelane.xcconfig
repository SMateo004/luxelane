// Luxelane iOS settings. These values are not secret (they ship inside
// the app); see DEPLOY.md → "iOS" for where each one comes from.

// Google Maps SDK key for iOS. It is not stored in the repository: put it in
// ios/Flutter/Secrets.xcconfig (ignored by git, see Secrets.xcconfig.example);
// CI writes that file from the GOOGLE_MAPS_IOS_API_KEY secret. A Release build
// without it stops at the "Check Google Maps key" build phase.
GOOGLE_MAPS_API_KEY =
#include? "Secrets.xcconfig"

// Google Sign-In — from the iOS app's GoogleService-Info.plist:
//   CLIENT_ID          → 51157842817-8bo82sf25c3qrsbqq4b0lh2ie00gc9t7.apps.googleusercontent.com
//   REVERSED_CLIENT_ID → com.googleusercontent.apps.51157842817-8bo82sf25c3qrsbqq4b0lh2ie00gc9t7
GOOGLE_IOS_CLIENT_ID = 51157842817-8bo82sf25c3qrsbqq4b0lh2ie00gc9t7.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.51157842817-8bo82sf25c3qrsbqq4b0lh2ie00gc9t7
