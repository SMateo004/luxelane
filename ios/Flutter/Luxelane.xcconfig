// Luxelane iOS settings. These values are not secret (they ship inside
// the app); see DEPLOY.md → "iOS" for where each one comes from.

// Google Maps SDK key (same key the web and AppConfig use).
GOOGLE_MAPS_API_KEY = AIzaSyBbDde6GtLHy9_6qys4BMmq2P2G2INRUkM

// Google Sign-In — from the iOS app's GoogleService-Info.plist:
//   CLIENT_ID          → GOOGLE_IOS_CLIENT_ID
//   REVERSED_CLIENT_ID → GOOGLE_REVERSED_CLIENT_ID (URL scheme Google
//                        uses to return to the app after signing in)
GOOGLE_IOS_CLIENT_ID = REPLACE_WITH_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID
