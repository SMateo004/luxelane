rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers — role is stored in /users/{uid}.role in Firestore
    // -------------------------------------------------------------------------

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    function isDriver() {
      return request.auth != null && getUserRole() == 'driver';
    }

    function isRider() {
      return request.auth != null && getUserRole() == 'rider';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // El admin bloquea cuentas con isActive = false.
    function isActiveUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('isActive', true) == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function onlyUpdating(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // -------------------------------------------------------------------------
    // /users/{uid}
    // -------------------------------------------------------------------------

    // Privileged fields: only an admin (or the Admin SDK in Cloud Functions,
    // which bypasses these rules) may set or change them. Nobody can make
    // themselves admin or driver from the client.
    function privilegedUserFields() {
      return ['role', 'isActive', 'stripeCustomerId', 'companyId', 'companyRole'];
    }

    // A self-created profile is always an active rider with no Stripe link.
    function isValidSelfSignup(uid) {
      let d = request.resource.data;
      return d.role == 'rider' &&
        !d.keys().hasAny(['companyId', 'companyRole']) &&
        d.get('isActive', true) == true &&
        d.get('stripeCustomerId', null) == null &&
        d.get('id', uid) == uid;
    }

    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && isValidSelfSignup(uid));
      allow update: if isAdmin() || (
        isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(privilegedUserFields())
      );
      allow delete: if false;
    }

    // In-app notifications: each user reads and marks their own as read.
    // Los avisos los escribe el servidor; nadie se fabrica avisos falsos.
    match /users/{uid}/notifications/{notificationId} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isAdmin();
      allow update: if (isOwner(uid) &&
        onlyUpdating(['isRead'])) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // /driverProfiles/{uid}
    // -------------------------------------------------------------------------

    // Verificación, valoración y contador de viajes los fijan el admin y el
    // servidor; el chófer no puede darse de alta ya verificado.
    function driverManagedFields() {
      return ['documentsVerified', 'rating', 'ratingCount', 'totalRides'];
    }

    match /driverProfiles/{uid} {
      // Un pasajero lee el perfil (ubicación) de su chófer por id; listar
      // todos los chóferes con su ubicación en vivo es solo del admin.
      allow get:    if isAuthenticated();
      allow list:   if isAdmin();
      allow create: if isOwner(uid) && isDriver() &&
        !request.resource.data.keys().hasAny(driverManagedFields());
      allow update: if isAdmin() || (isOwner(uid) && isDriver() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(driverManagedFields()));
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /bookings/{bookingId}
    // -------------------------------------------------------------------------

    // Pasos que un chófer puede dar sobre su reserva (igual que
    // AdminOperations en la app). Repetir el estado actual solo toca updatedAt.
    function isDriverStep(from, to) {
      return to == from ||
        (from == 'confirmed' && to == 'driver_arriving') ||
        (from == 'driver_arriving' && to == 'driver_arrived') ||
        (from == 'driver_arrived' && to == 'in_progress') ||
        (from == 'in_progress' && to == 'completed');
    }

    // Administrador activo de la empresa [cid].
    function isCompanyAdminOf(cid) {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && cid != null &&
        u.get('companyId', null) == cid &&
        u.get('companyRole', null) == 'admin' &&
        u.get('isActive', true) == true;
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid ||
        isCompanyAdminOf(resource.data.get('companyId', null)) ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.status == 'pending' && isDriver()) ||
        isAdmin()
      );

      // Any authenticated user can create a booking for themselves
      // El reparto y la revisión de tarifa solo los escribe el servidor.
      // Nace pendiente, sin chófer ni cobro: esos campos los escriben el
      // chófer al aceptar, el admin y el servidor.
      allow create: if isAuthenticated() &&
        isActiveUser() &&
        request.resource.data.riderId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        // Sin recogidas en el pasado (margen para la recogida inmediata).
        request.resource.data.scheduledAt is timestamp &&
        request.resource.data.scheduledAt > request.time - duration.value(15, 'm') &&
        request.resource.data.get('driverId', null) == null &&
        request.resource.data.get('paymentId', null) == null &&
        request.resource.data.get('finalPrice', null) == null &&
        request.resource.data.estimatedPrice is number &&
        request.resource.data.estimatedPrice > 0 &&
        !request.resource.data.keys().hasAny(['settlement', 'pricingReview',
          'refunded', 'stripePaymentIntentId', 'stripePaymentMethodId',
          'cardPaymentFailed', 'driverInfo', 'riderRating',
          'statementId', 'companyName', 'riderName']) &&
        // Cuenta de empresa: solo la propia; empresa activa y límites los
        // comprueba el servidor al crearse la reserva.
        (request.resource.data.get('paymentMethod', 'cash') == 'corporate'
          ? request.resource.data.get('companyId', null) != null &&
            request.resource.data.companyId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('companyId', null)
          : request.resource.data.get('companyId', null) == null) &&
        (request.resource.data.get('costCenter', null) == null ||
          (request.resource.data.costCenter is string &&
            request.resource.data.costCenter.size() <= 60));

      allow update: if isAdmin() ||
        // Driver accepts a pending booking (self-assign)
        (isDriver() && isActiveUser() &&
          get(/databases/$(database)/documents/driverProfiles/$(request.auth.uid))
            .data.get('documentsVerified', false) == true &&
          resource.data.status == 'pending' &&
          request.resource.data.driverId == request.auth.uid &&
          request.resource.data.status == 'confirmed' &&
          onlyUpdating(['driverId', 'status', 'updatedAt'])) ||
        // Driver progresses their assigned booking, one step at a time
        (isDriver() &&
          resource.data.driverId == request.auth.uid &&
          onlyUpdating(['status', 'updatedAt']) &&
          isDriverStep(resource.data.status, request.resource.data.status)) ||
        // Rider cancels their own booking before the trip starts
        (isAuthenticated() &&
          resource.data.riderId == request.auth.uid &&
          onlyUpdating(['status', 'updatedAt']) &&
          resource.data.status in
            ['pending', 'confirmed', 'driver_arriving', 'driver_arrived'] &&
          request.resource.data.status == 'cancelled') ||
        // Rider rates a completed trip, once
        (isAuthenticated() &&
          resource.data.riderId == request.auth.uid &&
          resource.data.status == 'completed' &&
          !('riderRating' in resource.data) &&
          onlyUpdating(['riderRating', 'riderComment', 'updatedAt']) &&
          request.resource.data.riderRating is int &&
          request.resource.data.riderRating >= 1 &&
          request.resource.data.riderRating <= 5);

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /rides/{rideId}
    // -------------------------------------------------------------------------

    match /rides/{rideId} {
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAdmin();

      allow update: if isAdmin() || (
        isAuthenticated() &&
        isDriver() &&
        resource.data.driverId == request.auth.uid &&
        onlyUpdating([
          'driverRoute',
          'completedAt',
          'distanceKm',
          'durationMin',
          'riderRating',
          'driverRating'
        ])
      );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /payments/{paymentId}
    // -------------------------------------------------------------------------

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid || isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /vehicles/{vehicleId}
    // -------------------------------------------------------------------------

    match /vehicles/{vehicleId} {
      allow read:   if isAuthenticated();
      allow create: if isAdmin() ||
        (isDriver() && isOwner(request.resource.data.driverId));
      // Activar o desactivar un vehículo es decisión del admin.
      allow update: if isAdmin() || (
        isDriver() &&
        resource.data.driverId == request.auth.uid &&
        onlyUpdating(['color', 'photoUrl'])
      );
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /pricingRules/{ruleId}
    // Tarifas públicas (la web las muestra sin sesión); solo el admin las
    // edita, con importes numéricos no negativos.
    // -------------------------------------------------------------------------

    function validFare(d) {
      return d.basePriceUsd is number && d.basePriceUsd >= 0 &&
        d.pricePerKmUsd is number && d.pricePerKmUsd >= 0 &&
        d.pricePerHourUsd is number && d.pricePerHourUsd >= 0 &&
        d.minimumPriceUsd is number && d.minimumPriceUsd >= 0 &&
        d.isActive is bool;
    }

    match /pricingRules/{ruleId} {
      allow read:   if true;
      allow create, update: if isAdmin() && validFare(request.resource.data);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // /config/{docId}
    // global: estado operativo (mantenimiento) que lee la app del pasajero.
    // finance: comisión y parámetros internos, solo para el admin.
    // -------------------------------------------------------------------------

    match /config/{docId} {
      allow read:  if docId == 'global' || isAdmin();
      allow write: if isAdmin() && (
        docId != 'finance' ||
        !('platformCommissionPct' in request.resource.data) || (
          request.resource.data.platformCommissionPct is number &&
          request.resource.data.platformCommissionPct >= 0 &&
          request.resource.data.platformCommissionPct <= 100
        )
      );
    }

    // -------------------------------------------------------------------------
    // /businessLeads/{id} — solicitudes de empresas (sin cuenta). Se crean
    // con campos acotados; solo el admin las lee y las marca atendidas.
    // -------------------------------------------------------------------------

    function shortText(v, max) {
      return v is string && v.size() <= max;
    }

    match /businessLeads/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['company', 'contactName',
          'email', 'phone', 'travellers', 'message', 'handled', 'createdAt']) &&
        shortText(request.resource.data.company, 120) &&
        request.resource.data.company.size() > 0 &&
        shortText(request.resource.data.contactName, 120) &&
        shortText(request.resource.data.email, 160) &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        shortText(request.resource.data.phone, 40) &&
        shortText(request.resource.data.travellers, 20) &&
        shortText(request.resource.data.message, 2000) &&
        request.resource.data.handled == false &&
        request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin() && onlyUpdating(['handled']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Programa para empresas — todo lo escribe el servidor (Cloud Functions)
    // -------------------------------------------------------------------------

    match /companies/{cid} {
      allow read: if isAdmin() ||
        (isAuthenticated() && userData().get('companyId', null) == cid);
      allow write: if false;

      match /members/{uid} {
        allow read: if isAdmin() || isOwner(uid) || isCompanyAdminOf(cid);
        allow write: if false;
      }
    }

    match /companyInvites/{inviteId} {
      allow read: if isAdmin() ||
        isCompanyAdminOf(resource.data.companyId) ||
        (isAuthenticated() &&
          resource.data.email == request.auth.token.email.lower());
      allow write: if false;
    }

    match /companyStatements/{statementId} {
      // La empresa ve sus extractos emitidos; el borrador es interno.
      allow read: if isAdmin() || (
        isCompanyAdminOf(resource.data.companyId) &&
        resource.data.status != 'draft');
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /specialRequests/{id} — servicios especiales bajo cotización
    // (aerotaxi, paseo por la ciudad). El cliente solicita; Luxelane cotiza;
    // el cliente acepta o rechaza.
    // -------------------------------------------------------------------------

    function isShortText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function isValidSpecialRequest() {
      let d = request.resource.data;
      return d.riderId == request.auth.uid &&
        d.status == 'new' &&
        d.keys().hasOnly(['riderId', 'riderName', 'riderEmail', 'riderPhone',
          'kind', 'date', 'passengers', 'from', 'to', 'pickup',
          'durationHours', 'language', 'notes', 'status', 'createdAt',
          'updatedAt']) &&
        isShortText(d.riderName, 0, 80) &&
        isShortText(d.get('riderPhone', ''), 0, 20) &&
        d.date is timestamp &&
        d.date > request.time &&
        d.date < request.time + duration.value(365, 'd') &&
        d.passengers is int && d.passengers >= 1 && d.passengers <= 12 &&
        isShortText(d.get('notes', ''), 0, 500) &&
        ((d.kind == 'aerotaxi' &&
            isShortText(d.from, 2, 60) && isShortText(d.to, 2, 60) &&
            d.from != d.to) ||
         (d.kind == 'cityTour' &&
            isShortText(d.pickup, 3, 120) &&
            d.durationHours in [2, 3, 4, 6] &&
            d.get('language', 'es') in ['es', 'en', 'pt']));
    }

    match /specialRequests/{requestId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow create: if isAuthenticated() && isActiveUser() &&
        isValidSpecialRequest();
      allow update: if isAdmin() || (
        resource.data.riderId == request.auth.uid &&
        onlyUpdating(['status', 'updatedAt']) && (
          // Cancelar antes de confirmar
          (resource.data.status in ['new', 'quoted'] &&
            request.resource.data.status == 'cancelled') ||
          // Aceptar la cotización recibida
          (resource.data.status == 'quoted' &&
            request.resource.data.status == 'confirmed')
        ));
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /admin_logs/{logId}  — auditoría inmutable
    // -------------------------------------------------------------------------

    match /admin_logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
