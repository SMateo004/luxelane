rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers — role is stored in /users/{uid}.role in Firestore
    // -------------------------------------------------------------------------

    // Rol: el custom claim `role`, que fija solo el servidor (setUserRole,
    // backfill). Transición (decisión 4): sin claim, el rol de Firestore;
    // se quita la segunda vía cuando el responsable confirme el backfill.
    // isActive se sigue leyendo de Firestore (isActiveUser).
    function getUserRole() {
      return request.auth.token.get('role', null) != null
        ? request.auth.token.role
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Admin con la cuenta activa: un admin bloqueado deja de serlo en el acto
    // aunque su token aún lleve el claim (decisión 4).
    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin' && isActiveUser();
    }

    // El admin no escribe nada desde el cliente (Parte A): todo pasa por
    // callables que exigen rol, segundo factor (con mfaEnforced) y motivo, y
    // escriben su auditoría en la misma transacción. Aquí solo lee.

    function isDriver() {
      return request.auth != null && getUserRole() == 'driver';
    }

    function isRider() {
      return request.auth != null && getUserRole() == 'rider';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // El admin bloquea cuentas con isActive = false.
    function isActiveUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('isActive', true) == true;
    }

    // Chófer habilitado para ver solicitudes: verificado por el admin y con
    // la cuenta activa (no bloqueada).
    function isVerifiedDriver() {
      return isDriver() && isActiveUser() &&
        get(/databases/$(database)/documents/driverProfiles/$(request.auth.uid))
          .data.get('documentsVerified', false) == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function onlyUpdating(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // -------------------------------------------------------------------------
    // /users/{uid}
    // -------------------------------------------------------------------------

    // Privileged fields: only an admin (or the Admin SDK in Cloud Functions,
    // which bypasses these rules) may set or change them. Nobody can make
    // themselves admin or driver from the client.
    // isVerified: la verificación no se la da uno mismo (matriz, H2).
    // phoneVerified: no hay proveedor de SMS; el teléfono no se verifica.
    // emailVerifiedAt: lo escribe syncEmailVerification (H6).
    // tripPreferences: solo updatePreferences (listas cerradas y nota
    // saneada). ridePreferences, de las apps anteriores, ya no se cambia
    // desde el cliente (el alta la sigue trayendo con los valores por
    // defecto; el servidor solo lee de ahí valores de la lista cerrada).
    function privilegedUserFields() {
      return ['role', 'isActive', 'stripeCustomerId', 'isVerified',
        'phoneVerified', 'emailVerifiedAt', 'terms', 'tripPreferences',
        'ridePreferences'];
    }

    // A self-created profile is always an active rider with no Stripe link,
    // sin correo ni teléfono verificados: eso lo escribe el servidor (H6).
    // La aceptación de los términos también (acceptTerms, decisión 7).
    function isValidSelfSignup(uid) {
      let d = request.resource.data;
      return d.role == 'rider' &&
        d.get('isActive', true) == true &&
        d.get('isVerified', false) == false &&
        d.get('phoneVerified', false) == false &&
        !('emailVerifiedAt' in d) &&
        !('terms' in d) &&
        !('tripPreferences' in d) &&
        d.get('stripeCustomerId', null) == null &&
        d.get('id', uid) == uid;
    }

    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      // Solo el alta propia: el panel no crea perfiles de otros y los
      // scripts usan el Admin SDK (A8.2).
      allow create: if isOwner(uid) && isValidSelfSignup(uid);
      // Rol, bloqueo y sus marcas los escribe solo el servidor (setUserRole,
      // setUserBlocked). El admin solo lee (Parte A).
      // Con la cuenta bloqueada solo puede quitar tokens de push (al cerrar
      // sesión): ni nombre, ni teléfono, ni tokens nuevos (D1).
      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(privilegedUserFields()) &&
        (resource.data.get('isActive', true) == true || onlyRemovingTokens());
      allow delete: if false;
    }

    function onlyRemovingTokens() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fcmTokens']) &&
        resource.data.get('fcmTokens', [])
          .hasAll(request.resource.data.get('fcmTokens', []));
    }

    // Avisos en la app: cada usuario lee y marca los suyos. Los crea el
    // servidor; el dueño no se escribe avisos que parezcan del sistema
    // (matriz, H3).
    match /users/{uid}/notifications/{notificationId} {
      allow read:   if isOwner(uid) || isAdmin();
      // Los crea solo el servidor (Admin SDK): ni el dueño ni el admin
      // desde el cliente (H3, A8.2).
      allow create: if false;
      allow update: if isOwner(uid) && onlyUpdating(['isRead']);
      allow delete: if isOwner(uid);
    }

    // -------------------------------------------------------------------------
    // /driverProfiles/{uid}
    // -------------------------------------------------------------------------

    // Licencia, documentos y verificación solo los ven el propio chófer y
    // el admin. El pasajero ve al chófer por `driverInfo` en su reserva y
    // por `bookings/{id}/tracking/driver`.
    // Datos que el admin revisó al verificar: después solo los cambia el
    // admin (el chófer contacta con central). Matriz, H4. Misma lista que
    // kLockedDriverProfileFields en lib/core/config/driver_documents.dart.
    function driverLockedFields() {
      return ['licenseNumber', 'licenseExpiry', 'vehicleId'];
    }

    // Todo lo que el chófer escribe en su perfil (kDriverOwnerFields en
    // driver_documents.dart). userId solo al crear y siempre su uid.
    function driverOwnerFields() {
      return ['userId', 'licenseNumber', 'licenseExpiry', 'vehicleId',
        'isAvailable', 'online', 'currentLocation'];
    }

    // Dejar de estar disponible siempre se permite: al cerrar sesión o al
    // ser bloqueado, la app lo apaga (matriz, H10).
    function onlyGoingOffline() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isAvailable', 'online']) &&
        request.resource.data.get('isAvailable', false) == false &&
        request.resource.data.get('online', false) == false;
    }

    match /driverProfiles/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      // El dueño escribe solo con la cuenta activa (H10).
      // Lista blanca (A8.5): el dueño solo escribe estos campos; cualquier
      // otro (verificación, valoración, documentos, fotos, datos de pago
      // que se añadan) es del admin o del servidor.
      allow create: if isOwner(uid) && isDriver() && isActiveUser() &&
        request.resource.data.keys().hasOnly(driverOwnerFields()) &&
        request.resource.data.get('userId', uid) == uid;
      // Verificar y cambiar datos sensibles: adminVerifyDriver y
      // adminUpdateDriverSensitive (Parte A).
      allow update: if (isOwner(uid) && isDriver() && (
        onlyGoingOffline() || (
          isActiveUser() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(driverOwnerFields()) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['userId']) &&
          !(resource.data.get('documentsVerified', false) == true &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(driverLockedFields())))));
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /bookings/{bookingId}
    // -------------------------------------------------------------------------

    // Los pasos del viaje desde la recogida los escribe solo el servidor
    // (advanceBooking, verifyPickup, adminOverrideVerify), con su registro en
    // events (D1). Ningún cliente cambia status a estos estados.
    function serverOnlyStatus() {
      return ['driver_arriving', 'driver_arrived', 'verified', 'in_progress', 'completed'];
    }

    // updatedAt que manda la app (hora del dispositivo): una marca de tiempo
    // cercana a la del servidor, o ninguna.
    function validClientUpdatedAt() {
      return !('updatedAt' in request.resource.data) ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) || (
          request.resource.data.updatedAt is timestamp &&
          request.resource.data.updatedAt > request.time - duration.value(15, 'm') &&
          request.resource.data.updatedAt < request.time + duration.value(15, 'm'));
    }

    // La reserva completa (direcciones, notas, datos del pasajero) solo la
    // leen el pasajero, el chófer asignado y el admin. Las preferencias para
    // el chófer no van aquí: están en driverView, con su ventana. Los
    // chóferes ven las pendientes en /openRequests, sin datos personales.
    match /bookings/{bookingId} {
      // El chófer asignado solo con la cuenta activa: uno bloqueado deja de
      // ver los datos del pasajero en el acto (matriz, H1).
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid ||
        (resource.data.get('driverId', null) == request.auth.uid &&
          isActiveUser()) ||
        isAdmin()
      );

      // Solo el servidor crea reservas (createBooking): calcula el precio y
      // escribe la reserva y su solicitud abierta en una transacción (D2).
      allow create: if false;

      // El admin asigna, cancela, mueve el estado y ajusta el importe con
      // adminUpdateBooking (Parte A): desde aquí no escribe.
      allow update: if
        // Driver accepts a pending booking (self-assign)
        (isDriver() && isActiveUser() &&
          get(/databases/$(database)/documents/driverProfiles/$(request.auth.uid))
            .data.get('documentsVerified', false) == true &&
          resource.data.status == 'pending' &&
          // Quien la liberó no la vuelve a aceptar (0.3).
          !(request.auth.uid in resource.data.get('releasedBy', [])) &&
          // Sin pago confirmado no se ofrece ni se acepta (pagos, A3). Sin
          // estado de pago (reservas antiguas), get() falla y se deniega.
          get(/databases/$(database)/documents/bookings/$(bookingId)/payment/state)
            .data.get('paymentStatus', '') == 'paid' &&
          request.resource.data.driverId == request.auth.uid &&
          request.resource.data.status == 'confirmed' &&
          onlyUpdating(['driverId', 'status', 'updatedAt'])) ||
        // Cancelar ya no se escribe desde la app: el pasajero usa
        // cancelBooking, que deja motivo, recargo y evento (Parte B, B2/B7).
        // El pasajero valora un viaje terminado, una vez: nota entera de 1
        // a 5 y comentario de texto acotado (A8.6).
        (isAuthenticated() &&
          resource.data.riderId == request.auth.uid &&
          resource.data.status == 'completed' &&
          !('riderRating' in resource.data) &&
          onlyUpdating(['riderRating', 'riderComment', 'updatedAt']) &&
          validClientUpdatedAt() &&
          request.resource.data.riderRating is int &&
          request.resource.data.riderRating >= 1 &&
          request.resource.data.riderRating <= 5 &&
          (!('riderComment' in request.resource.data) ||
            (request.resource.data.riderComment is string &&
              request.resource.data.riderComment.size() <= 1000)));

      allow delete: if false;

      // Ubicación en vivo del chófer asignado: solo lat/lng. El pasajero la
      // ve únicamente mientras el chófer va, espera o lo lleva.
      match /tracking/{docId} {
        function booking() {
          return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
        }
        function isLive(status) {
          return status in
            ['driver_arriving', 'driver_arrived', 'verified', 'in_progress'];
        }

        allow read: if isAuthenticated() && (
          (booking().riderId == request.auth.uid && isLive(booking().status)) ||
          (booking().get('driverId', null) == request.auth.uid && isActiveUser()) ||
          isAdmin()
        );
        allow create, update: if docId == 'driver' &&
          isDriver() && isActiveUser() &&
          booking().get('driverId', null) == request.auth.uid &&
          isLive(booking().status) &&
          request.resource.data.keys().hasOnly(['lat', 'lng', 'updatedAt']) &&
          request.resource.data.lat is number &&
          request.resource.data.lng is number &&
          request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // Teléfono del chófer asignado (D16): lo escribe el servidor. El
      // pasajero solo lo lee en la misma ventana que la ubicación en vivo;
      // en el historial y al valorar ya no está disponible.
      match /driverContact/{docId} {
        function contactBooking() {
          return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
        }

        allow read: if isAuthenticated() && (
          (contactBooking().riderId == request.auth.uid &&
            contactBooking().status in
              ['driver_arriving', 'driver_arrived', 'verified', 'in_progress']) ||
          (contactBooking().get('driverId', null) == request.auth.uid &&
            isActiveUser()) ||
          isAdmin()
        );
        allow write: if false;
      }

      // Preferencias del pasajero para este viaje (copia que guarda
      // createBooking; cambiar el perfil después no la cambia). Las lee el
      // pasajero dueño, el admin y el chófer asignado y activo solo desde
      // que se le asigna hasta que termina el viaje (confirmed a
      // in_progress): ni antes, ni al completarse, ni tras liberarla.
      match /driverView/{docId} {
        function viewBooking() {
          return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
        }

        allow read: if isAuthenticated() && (
          viewBooking().riderId == request.auth.uid ||
          (isDriver() && isActiveUser() &&
            viewBooking().get('driverId', null) == request.auth.uid &&
            viewBooking().status in ['confirmed', 'driver_arriving',
              'driver_arrived', 'verified', 'in_progress']) ||
          isAdmin()
        );
        allow write: if false;
      }

      // Sal del código de recogida e intentos fallidos: solo el servidor.
      // Ni el pasajero ni el chófer (que podría deducir el código) la leen.
      match /private/{docId} {
        allow read, write: if false;
      }

      // Estado del pago (A1): lo escribe solo el servidor. Lo leen el
      // pasajero dueño y el admin; el chófer, nunca (ni importes ni
      // retenciones): por eso no va en la reserva, que el chófer lee entera.
      match /payment/{docId} {
        allow read: if isAuthenticated() && (
          resource.data.riderId == request.auth.uid || isAdmin()
        );
        allow write: if false;
      }

      // Registro de transiciones (solo anexado): lo escribe el servidor y
      // nadie lo edita ni lo borra. Lo leen el pasajero, el chófer asignado
      // y el admin.
      match /events/{eventId} {
        function eventsBooking() {
          return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
        }

        allow read: if isAuthenticated() && (
          eventsBooking().riderId == request.auth.uid ||
          (eventsBooking().get('driverId', null) == request.auth.uid &&
            isActiveUser()) ||
          isAdmin()
        );
        allow create, update, delete: if false;
      }

      // Ubicación del chófer en cada evento: solo el admin.
      match /eventLocations/{eventId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }

      // Lo que de cada evento solo ve central: motivo del admin al forzar
      // la verificación y control de llegada (farFromPickup). A8.7.
      match /eventDetails/{eventId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }

      // Estado de incidentes de la reserva (incidentOpen, activeIncidentId):
      // fuera del documento de la reserva, que lee también la contraparte.
      // Solo el servidor escribe; solo el admin lee.
      match /adminOnly/{docId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // /incidents/{incidentId} — SOS (D1, F9). Los crea y cambia solo el
    // servidor (raiseIncident y compañía). Los lee quien lo disparó y el
    // admin; la contraparte del viaje, nunca.
    // -------------------------------------------------------------------------

    function liveIncident(incidentId) {
      return get(/databases/$(database)/documents/incidents/$(incidentId)).data;
    }

    // Una ubicación por tramo de 10 s: el ID del documento es el tramo
    // (milisegundos / 10000) y solo se crea, nunca se reescribe.
    function isCurrentLocationSlot(slot) {
      let now = math.floor(request.time.toMillis() / 10000);
      return slot.matches('^[0-9]{1,15}$') &&
        int(slot) >= now - 1 && int(slot) <= now + 1;
    }

    match /incidents/{incidentId} {
      allow read: if isAuthenticated() && (
        resource.data.reporterId == request.auth.uid || isAdmin()
      );
      allow write: if false;

      // Ubicación en vivo de quien lo disparó, mientras siga abierto.
      match /locations/{slot} {
        allow read: if isAuthenticated() && (
          liveIncident(incidentId).reporterId == request.auth.uid || isAdmin()
        );
        allow create: if isAuthenticated() &&
          liveIncident(incidentId).reporterId == request.auth.uid &&
          liveIncident(incidentId).status in ['open', 'acknowledged'] &&
          // Si quien lo disparó lo canceló, deja de compartir su ubicación
          // aunque el admin lo reconozca después (la escalada sigue).
          liveIncident(incidentId).get('cancelledByReporter', false) == false &&
          isCurrentLocationSlot(slot) &&
          request.resource.data.keys().hasOnly(['lat', 'lng', 'at']) &&
          request.resource.data.lat is number &&
          request.resource.data.lat >= -90 && request.resource.data.lat <= 90 &&
          request.resource.data.lng is number &&
          request.resource.data.lng >= -180 && request.resource.data.lng <= 180 &&
          request.resource.data.at == request.time;
        allow update, delete: if false;
      }

      // Registro del incidente: solo el servidor lo escribe; solo el admin.
      match /events/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Límite de disparos por usuario: solo el servidor.
    match /incidentRateLimits/{uid} {
      allow read, write: if false;
    }

    // Contadores de límites de tasa de las callables: solo el servidor.
    match /rateLimits/{counterId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // /openRequests/{bookingId} — lo que un chófer ve antes de aceptar: clase,
    // hora, precio, zona aproximada. La escribe y borra el servidor.
    // -------------------------------------------------------------------------

    match /openRequests/{bookingId} {
      allow read:  if isVerifiedDriver() || isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /rides/{rideId}
    // -------------------------------------------------------------------------

    // Colección heredada: ninguna app ni función la usa (matriz, H7). Los
    // documentos existentes se conservan; solo el admin los lee.
    match /rides/{rideId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /payments/{paymentId}
    // -------------------------------------------------------------------------

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid || isAdmin()
      );
      // Asientos (charge, refund, fee_retained) y cobros antiguos: solo el
      // servidor. El chófer no lee ninguno (A1).
      allow create, update, delete: if false;
    }

    // Unicidad de la referencia del pago y del número de operación (A1, A4):
    // solo el servidor; nadie los lee desde el cliente.
    match /paymentRefs/{ref} {
      allow read, write: if false;
    }
    match /paymentOperations/{key} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // /vehicles/{vehicleId}
    // -------------------------------------------------------------------------

    // Datos de cada chófer (placa incluida): solo los ven él mismo y el
    // admin; el pasajero ve el vehículo por driverInfo en su reserva. El
    // chófer registra su vehículo inactivo: lo activa el admin al verificar.
    match /vehicles/{vehicleId} {
      allow read:   if isAdmin() ||
        (isAuthenticated() && resource.data.driverId == request.auth.uid);
      // Un chófer bloqueado no registra vehículos (matriz, H8).
      // Lo registra el chófer en su alta; el panel no crea vehículos (A8.2).
      allow create: if (isDriver() && isActiveUser() &&
          isOwner(request.resource.data.driverId) &&
          request.resource.data.isActive == false);
      // Activar o desactivar un vehículo es decisión del admin. Placa,
      // clase, marca, modelo y año los cambia solo el admin (H4): el chófer,
      // color y foto (kEditableVehicleFields en driver_documents.dart).
      // Activar y corregir datos del admin: adminSetVehicleActive y
      // adminUpdateDriverSensitive (Parte A).
      // Un chófer bloqueado tampoco cambia color ni foto (D1).
      allow update: if isDriver() && isActiveUser() &&
        resource.data.driverId == request.auth.uid &&
        onlyUpdating(['color', 'photoUrl']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /pricingRules/{ruleId}
    // Tarifas públicas (la web las muestra sin sesión). Las escribe solo
    // adminUpdatePricingRule, con los campos públicos (A8.8, C3).
    // -------------------------------------------------------------------------

    match /pricingRules/{ruleId} {
      allow read:   if true;
      // Crear, cambiar y desactivar: adminUpdatePricingRule (Parte A).
      allow create, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // /config/{docId}
    // global: estado operativo (mantenimiento) que lee la app del pasajero.
    // finance: comisión y parámetros internos, solo para el admin.
    // -------------------------------------------------------------------------

    // config/ops (tiempos del SOS, retención, radio de llegada): la lee el
    // admin, la escribe solo la consola. config/security (segundo factor,
    // sesión de admin): ningún cliente. El servidor las lee con el Admin
    // SDK (A8.9).
    match /config/{docId} {
      allow read:  if docId == 'global' ||
        (isAdmin() && docId != 'security');
      // global (lista blanca), finance y ops: adminUpdateConfig (Parte A);
      // security, solo la consola.
      allow create, update: if false;
      // La configuración se actualiza, no se borra: sin config/global las
      // funciones y las apps caen a sus valores por defecto (matriz, H9).
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /businessLeads/{id} — solicitudes de empresas (sin cuenta). Solo el
    // admin las lee y las marca atendidas.
    // -------------------------------------------------------------------------

    // Las crea solo submitBusinessLead (esquema, campo trampa, límites por
    // IP y correo, App Check): matriz, H5.
    match /businessLeads/{id} {
      allow create: if false;
      allow read: if isAdmin();
      // Marcar atendida: adminSetLeadHandled (Parte A).
      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /adminAlerts/{alertId} — avisos del servidor al admin (precio con
    // distancia aproximada, reconciliación de solicitudes). Solo el servidor
    // los escribe.
    // -------------------------------------------------------------------------

    match /adminAlerts/{alertId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /driverDevices/{uid}/** — dispositivos del chófer y sus eventos
    // (decisión 5). Los escribe registerDriverDevice; solo el admin los ve.
    // -------------------------------------------------------------------------

    match /driverDevices/{uid}/{document=**} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /admin_logs/{logId}  — auditoría inmutable
    // -------------------------------------------------------------------------

    match /admin_logs/{logId} {
      allow read:   if isAdmin();
      // Solo el servidor la escribe, en la transacción de cada cambio
      // (Parte A): ningún cliente, tampoco el admin.
      allow create: if false;
      allow update, delete: if false;
    }
  }
}
