rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers — role is stored in /users/{uid}.role in Firestore
    // -------------------------------------------------------------------------

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    function isDriver() {
      return request.auth != null && getUserRole() == 'driver';
    }

    function isRider() {
      return request.auth != null && getUserRole() == 'rider';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // El admin bloquea cuentas con isActive = false.
    function isActiveUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('isActive', true) == true;
    }

    // Chófer habilitado para ver solicitudes: verificado por el admin y con
    // la cuenta activa (no bloqueada).
    function isVerifiedDriver() {
      return isDriver() && isActiveUser() &&
        get(/databases/$(database)/documents/driverProfiles/$(request.auth.uid))
          .data.get('documentsVerified', false) == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function onlyUpdating(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // -------------------------------------------------------------------------
    // /users/{uid}
    // -------------------------------------------------------------------------

    // Privileged fields: only an admin (or the Admin SDK in Cloud Functions,
    // which bypasses these rules) may set or change them. Nobody can make
    // themselves admin or driver from the client.
    function privilegedUserFields() {
      return ['role', 'isActive', 'stripeCustomerId'];
    }

    // A self-created profile is always an active rider with no Stripe link.
    function isValidSelfSignup(uid) {
      let d = request.resource.data;
      return d.role == 'rider' &&
        d.get('isActive', true) == true &&
        d.get('stripeCustomerId', null) == null &&
        d.get('id', uid) == uid;
    }

    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && isValidSelfSignup(uid));
      allow update: if isAdmin() || (
        isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(privilegedUserFields())
      );
      allow delete: if false;
    }

    // In-app notifications: each user reads and marks their own as read.
    match /users/{uid}/notifications/{notificationId} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if (isOwner(uid) &&
        onlyUpdating(['isRead'])) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // /driverProfiles/{uid}
    // -------------------------------------------------------------------------

    // Verificación, valoración y contador de viajes los fijan el admin y el
    // servidor; el chófer no puede darse de alta ya verificado.
    function driverManagedFields() {
      return ['documentsVerified', 'rating', 'ratingCount', 'totalRides'];
    }

    // Licencia, documentos y verificación solo los ven el propio chófer y
    // el admin. El pasajero ve al chófer por `driverInfo` en su reserva y
    // por `bookings/{id}/tracking/driver`.
    match /driverProfiles/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && isDriver() &&
        !request.resource.data.keys().hasAny(driverManagedFields());
      allow update: if isAdmin() || (isOwner(uid) && isDriver() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(driverManagedFields()));
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /bookings/{bookingId}
    // -------------------------------------------------------------------------

    // Pasos que un chófer puede dar sobre su reserva (igual que
    // AdminOperations en la app). Repetir el estado actual solo toca updatedAt.
    function isDriverStep(from, to) {
      return to == from ||
        (from == 'confirmed' && to == 'driver_arriving') ||
        (from == 'driver_arriving' && to == 'driver_arrived') ||
        (from == 'driver_arrived' && to == 'in_progress') ||
        (from == 'in_progress' && to == 'completed');
    }

    // La reserva completa (direcciones, notas, preferencias, datos del
    // pasajero) solo la leen el pasajero, el chófer asignado y el admin. Los
    // chóferes ven las pendientes en /openRequests, sin datos personales.
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid ||
        resource.data.get('driverId', null) == request.auth.uid ||
        isAdmin()
      );

      // Any authenticated user can create a booking for themselves
      // El reparto y la revisión de tarifa solo los escribe el servidor.
      // Nace pendiente, sin chófer ni cobro: esos campos los escriben el
      // chófer al aceptar, el admin y el servidor.
      allow create: if isAuthenticated() &&
        isActiveUser() &&
        request.resource.data.riderId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        // Sin recogidas en el pasado (margen para la recogida inmediata).
        request.resource.data.scheduledAt is timestamp &&
        request.resource.data.scheduledAt > request.time - duration.value(15, 'm') &&
        request.resource.data.get('driverId', null) == null &&
        request.resource.data.get('paymentId', null) == null &&
        request.resource.data.get('finalPrice', null) == null &&
        request.resource.data.estimatedPrice is number &&
        request.resource.data.estimatedPrice > 0 &&
        // Zona (ciudad o aeropuerto) que el servidor copia en openRequests.
        optionalText(request.resource.data, 'pickupArea', 80) &&
        optionalText(request.resource.data, 'dropoffArea', 80) &&
        // Pasajero de una reserva para otra persona: campos acotados, nunca
        // mezclados con las notas.
        (!('guest' in request.resource.data) ||
          validGuest(request.resource.data.guest)) &&
        !request.resource.data.keys().hasAny(['settlement', 'pricingReview',
          'refunded', 'stripePaymentIntentId', 'stripePaymentMethodId',
          'cardPaymentFailed', 'driverInfo', 'riderRating']);

      allow update: if isAdmin() ||
        // Driver accepts a pending booking (self-assign)
        (isDriver() && isActiveUser() &&
          get(/databases/$(database)/documents/driverProfiles/$(request.auth.uid))
            .data.get('documentsVerified', false) == true &&
          resource.data.status == 'pending' &&
          request.resource.data.driverId == request.auth.uid &&
          request.resource.data.status == 'confirmed' &&
          onlyUpdating(['driverId', 'status', 'updatedAt'])) ||
        // Driver progresses their assigned booking, one step at a time
        (isDriver() &&
          resource.data.driverId == request.auth.uid &&
          onlyUpdating(['status', 'updatedAt']) &&
          isDriverStep(resource.data.status, request.resource.data.status)) ||
        // Rider cancels their own booking before the trip starts
        (isAuthenticated() &&
          resource.data.riderId == request.auth.uid &&
          onlyUpdating(['status', 'updatedAt']) &&
          resource.data.status in
            ['pending', 'confirmed', 'driver_arriving', 'driver_arrived'] &&
          request.resource.data.status == 'cancelled') ||
        // Rider rates a completed trip, once
        (isAuthenticated() &&
          resource.data.riderId == request.auth.uid &&
          resource.data.status == 'completed' &&
          !('riderRating' in resource.data) &&
          onlyUpdating(['riderRating', 'riderComment', 'updatedAt']) &&
          request.resource.data.riderRating is int &&
          request.resource.data.riderRating >= 1 &&
          request.resource.data.riderRating <= 5);

      allow delete: if false;

      // Ubicación en vivo del chófer asignado: solo lat/lng. El pasajero la
      // ve únicamente mientras el chófer va, espera o lo lleva.
      match /tracking/{docId} {
        function booking() {
          return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
        }
        function isLive(status) {
          return status in ['driver_arriving', 'driver_arrived', 'in_progress'];
        }

        allow read: if isAuthenticated() && (
          (booking().riderId == request.auth.uid && isLive(booking().status)) ||
          booking().get('driverId', null) == request.auth.uid ||
          isAdmin()
        );
        allow create, update: if docId == 'driver' &&
          isDriver() && isActiveUser() &&
          booking().get('driverId', null) == request.auth.uid &&
          isLive(booking().status) &&
          request.resource.data.keys().hasOnly(['lat', 'lng', 'updatedAt']) &&
          request.resource.data.lat is number &&
          request.resource.data.lng is number &&
          request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // Teléfono del chófer asignado (D16): lo escribe el servidor. El
      // pasajero solo lo lee en la misma ventana que la ubicación en vivo;
      // en el historial y al valorar ya no está disponible.
      match /driverContact/{docId} {
        function contactBooking() {
          return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
        }

        allow read: if isAuthenticated() && (
          (contactBooking().riderId == request.auth.uid &&
            contactBooking().status in
              ['driver_arriving', 'driver_arrived', 'in_progress']) ||
          contactBooking().get('driverId', null) == request.auth.uid ||
          isAdmin()
        );
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // /openRequests/{bookingId} — lo que un chófer ve antes de aceptar: clase,
    // hora, precio, zona aproximada. La escribe y borra el servidor.
    // -------------------------------------------------------------------------

    match /openRequests/{bookingId} {
      allow read:  if isVerifiedDriver() || isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /rides/{rideId}
    // -------------------------------------------------------------------------

    match /rides/{rideId} {
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAdmin();

      allow update: if isAdmin() || (
        isAuthenticated() &&
        isDriver() &&
        resource.data.driverId == request.auth.uid &&
        onlyUpdating([
          'driverRoute',
          'completedAt',
          'distanceKm',
          'durationMin',
          'riderRating',
          'driverRating'
        ])
      );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /payments/{paymentId}
    // -------------------------------------------------------------------------

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid || isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /vehicles/{vehicleId}
    // -------------------------------------------------------------------------

    // Datos de cada chófer (placa incluida): solo los ven él mismo y el
    // admin; el pasajero ve el vehículo por driverInfo en su reserva. El
    // chófer registra su vehículo inactivo: lo activa el admin al verificar.
    match /vehicles/{vehicleId} {
      allow read:   if isAdmin() ||
        (isAuthenticated() && resource.data.driverId == request.auth.uid);
      allow create: if isAdmin() ||
        (isDriver() && isOwner(request.resource.data.driverId) &&
          request.resource.data.isActive == false);
      // Activar o desactivar un vehículo es decisión del admin.
      allow update: if isAdmin() || (
        isDriver() &&
        resource.data.driverId == request.auth.uid &&
        onlyUpdating(['color', 'photoUrl'])
      );
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /pricingRules/{ruleId}
    // Tarifas públicas (la web las muestra sin sesión); solo el admin las
    // edita, con importes numéricos no negativos.
    // -------------------------------------------------------------------------

    function validFare(d) {
      return d.basePriceUsd is number && d.basePriceUsd >= 0 &&
        d.pricePerKmUsd is number && d.pricePerKmUsd >= 0 &&
        d.pricePerHourUsd is number && d.pricePerHourUsd >= 0 &&
        d.minimumPriceUsd is number && d.minimumPriceUsd >= 0 &&
        d.isActive is bool;
    }

    match /pricingRules/{ruleId} {
      allow read:   if true;
      allow create, update: if isAdmin() && validFare(request.resource.data);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // /config/{docId}
    // global: estado operativo (mantenimiento) que lee la app del pasajero.
    // finance: comisión y parámetros internos, solo para el admin.
    // -------------------------------------------------------------------------

    match /config/{docId} {
      allow read:  if docId == 'global' || isAdmin();
      allow write: if isAdmin() && (
        docId != 'finance' ||
        !('platformCommissionPct' in request.resource.data) || (
          request.resource.data.platformCommissionPct is number &&
          request.resource.data.platformCommissionPct >= 0 &&
          request.resource.data.platformCommissionPct <= 100
        )
      );
    }

    // -------------------------------------------------------------------------
    // /businessLeads/{id} — solicitudes de empresas (sin cuenta). Se crean
    // con campos acotados; solo el admin las lee y las marca atendidas.
    // -------------------------------------------------------------------------

    function shortText(v, max) {
      return v is string && v.size() <= max;
    }

    function optionalText(d, field, max) {
      return !(field in d) || shortText(d[field], max);
    }

    function validGuest(g) {
      return g is map &&
        g.keys().hasOnly(['title', 'firstName', 'lastName', 'phone', 'email',
          'language']) &&
        shortText(g.firstName, 80) && g.firstName.size() > 0 &&
        optionalText(g, 'title', 20) &&
        optionalText(g, 'lastName', 80) &&
        optionalText(g, 'phone', 40) &&
        optionalText(g, 'email', 160) &&
        optionalText(g, 'language', 40);
    }

    match /businessLeads/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['company', 'contactName',
          'email', 'phone', 'travellers', 'message', 'handled', 'createdAt']) &&
        shortText(request.resource.data.company, 120) &&
        request.resource.data.company.size() > 0 &&
        shortText(request.resource.data.contactName, 120) &&
        shortText(request.resource.data.email, 160) &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        shortText(request.resource.data.phone, 40) &&
        shortText(request.resource.data.travellers, 20) &&
        shortText(request.resource.data.message, 2000) &&
        request.resource.data.handled == false &&
        request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin() && onlyUpdating(['handled']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /admin_logs/{logId}  — auditoría inmutable
    // -------------------------------------------------------------------------

    match /admin_logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
