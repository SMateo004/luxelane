rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers — role is stored in /users/{uid}.role in Firestore.
    // The role field can only be written by admins (or the Admin SDK), never
    // by the user themselves — see /users rules below.
    // -------------------------------------------------------------------------

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    function isDriver() {
      return request.auth != null && getUserRole() == 'driver';
    }

    // Admins turn accounts off with users/{uid}.isActive (missing = active).
    function isActiveUser() {
      return myUser().get('isActive', true) != false;
    }

    function isVerifiedDriver() {
      return isDriver() && isActiveUser() &&
        get(/databases/$(database)/documents/driverProfiles/$(request.auth.uid)).data.documentsVerified == true;
    }

    // Corporate accounts: users/{uid}.companyId / companyRole are written only
    // by Cloud Functions (see the /users rules).
    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCompanyMember(companyId) {
      return request.auth != null && myUser().get('companyId', null) == companyId;
    }

    function isCompanyAdminOf(companyId) {
      return isCompanyMember(companyId) && myUser().get('companyRole', null) == 'admin';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function onlyUpdating(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function notChanging(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Allowed booking status transitions for the assigned driver.
    // Same-status writes are allowed so `updatedAt` refreshes don't fail.
    function isValidDriverTransition(from, to) {
      return from == to
        || (from == 'confirmed'       && to in ['driver_arriving', 'cancelled'])
        || (from == 'driver_arriving' && to == 'driver_arrived')
        || (from == 'driver_arrived'  && to == 'in_progress')
        || (from == 'in_progress'     && to == 'completed');
    }

    // -------------------------------------------------------------------------
    // /users/{uid}
    // -------------------------------------------------------------------------

    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();

      // Self-registration may only pick rider or driver. Admin is granted
      // exclusively via scripts/promote_admin.mjs (Admin SDK) or another admin.
      allow create: if isAdmin() || isOwner(uid) &&
        request.resource.data.role in ['rider', 'driver'] &&
        request.resource.data.get('isVerified', false) == false &&
        request.resource.data.get('stripeCustomerId', null) == null &&
        request.resource.data.get('companyId', null) == null &&
        request.resource.data.get('companyRole', null) == null;

      // Users can edit their own profile, but never their role, verification
      // or Stripe linkage.
      // Admins can't turn their own account off (no lock-out).
      allow update: if (isAdmin() && !(isOwner(uid) && request.resource.data.get('isActive', true) == false)) || (
        isOwner(uid) &&
        notChanging(['role', 'isVerified', 'isActive', 'stripeCustomerId', 'email', 'companyId', 'companyRole'])
      );
      allow delete: if false;

      // In-app notifications (bell). The owner may write to their own inbox
      // (ride status updates are generated client-side today) and flip `isRead`.
      match /notifications/{notificationId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow create: if (isOwner(uid) && request.resource.data.userId == uid) || isAdmin();
        allow update: if (isOwner(uid) && onlyUpdating(['isRead'])) || isAdmin();
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // /driverProfiles/{uid}
    // -------------------------------------------------------------------------

    match /driverProfiles/{uid} {
      // Private: riders see their chauffeur through the booking's `chauffeur`
      // snapshot and the per-booking tracking doc, never through this one.
      allow read:   if isOwner(uid) || isAdmin();

      // Onboarding: a driver creates an unverified profile with no history.
      allow create: if isOwner(uid) && isDriver() && isActiveUser() &&
        request.resource.data.get('isAvailable', false) == false &&
        request.resource.data.get('suspended', false) == false &&
        request.resource.data.documentsVerified == false &&
        request.resource.data.totalRides == 0 &&
        request.resource.data.rating == 0;

      // Drivers may update their own operational fields only. Verification,
      // rating and ride count are owned by admins / Cloud Functions.
      allow update: if isAdmin() || (
        isOwner(uid) && isDriver() &&
        notChanging(['documentsVerified', 'rating', 'ratingCount', 'totalRides', 'userId', 'suspended']) &&
        // Only one of the chauffeur's own vehicles.
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['vehicleId']) ||
          request.resource.data.vehicleId == null ||
          get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.driverId == uid) &&
        // A suspended chauffeur can't go online.
        (request.resource.data.get('isAvailable', false) != true || isActiveUser())
      );
      allow delete: if false;

      // Verification documents. The chauffeur uploads (always as 'pending',
      // pointing at a file in their own Storage folder); only admins review,
      // through the reviewDriverDocument Cloud Function.
      match /verificationDocs/{docType} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) && isDriver() &&
          docType in ['license', 'idCard', 'criminalRecord', 'soat', 'vehicleRegistration'] &&
          request.resource.data.keys().hasOnly(
            ['type', 'status', 'storagePath', 'fileName', 'contentType', 'expiresAt', 'uploadedAt']) &&
          request.resource.data.type == docType &&
          request.resource.data.status == 'pending' &&
          request.resource.data.storagePath is string &&
          request.resource.data.storagePath.matches('driver_documents/' + uid + '/[^/]+');
        allow delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // /bookings/{bookingId}
    // -------------------------------------------------------------------------

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        // Only verified, active chauffeurs see open requests (they carry the
        // passenger's name, phone and addresses).
        (resource.data.status == 'pending' && isVerifiedDriver()) ||
        // Company admins see every ride billed to their company.
        (resource.data.get('companyId', null) != null && isCompanyAdminOf(resource.data.companyId)) ||
        isAdmin()
      );

      // Bookings are created only by the `createBooking` Cloud Function, which
      // takes price, route and vehicle from a server-issued quote.
      allow create: if false;

      allow update: if isAdmin() ||
        // Verified driver accepts a pending booking (self-assign)
        (isVerifiedDriver() &&
          resource.data.status == 'pending' &&
          // Targeted (proximity) offers can only be taken by the offered driver.
          (resource.data.get('dispatch', null) == null ||
            resource.data.dispatch.mode != 'targeted' ||
            resource.data.dispatch.offeredTo == request.auth.uid) &&
          request.resource.data.driverId == request.auth.uid &&
          request.resource.data.status == 'confirmed' &&
          onlyUpdating(['driverId', 'status', 'updatedAt'])) ||
        // Assigned driver progresses the booking along the state machine
        // (not once suspended: an admin reassigns or cancels the ride).
        (isDriver() && isActiveUser() &&
          resource.data.driverId == request.auth.uid &&
          onlyUpdating(['status', 'updatedAt']) &&
          isValidDriverTransition(resource.data.status, request.resource.data.status));
      // Riders cancel through the cancelBooking Cloud Function, which records
      // late cancellations and frees the chauffeur.

      allow delete: if isAdmin();

      // Live position of the assigned chauffeur, shared only with this
      // booking's rider while the trip is active.
      match /tracking/{docId} {
        function booking() {
          return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
        }
        allow read: if isAuthenticated() && (
          booking().riderId == request.auth.uid ||
          booking().driverId == request.auth.uid ||
          isAdmin()
        );
        allow create, update: if isDriver() && isActiveUser() &&
          docId == 'live' &&
          booking().driverId == request.auth.uid &&
          booking().status in ['confirmed', 'driver_arriving', 'driver_arrived', 'in_progress'] &&
          request.resource.data.keys().hasOnly(['lat', 'lng', 'heading', 'speed', 'updatedAt']) &&
          request.resource.data.lat is number &&
          request.resource.data.lng is number;
        allow delete: if isAdmin() || (isDriver() && booking().driverId == request.auth.uid);
      }
    }

    // -------------------------------------------------------------------------
    // /quotes/{quoteId} — server-issued fixed prices (Cloud Functions only)
    // -------------------------------------------------------------------------

    match /quotes/{quoteId} {
      allow read:  if isAuthenticated() &&
        (resource.data.riderId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /rides/{rideId}
    // -------------------------------------------------------------------------

    match /rides/{rideId} {
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAdmin();

      allow update: if isAdmin() ||
        // Driver records route/metrics and rates the rider
        (isDriver() &&
          resource.data.driverId == request.auth.uid &&
          onlyUpdating(['driverRoute', 'completedAt', 'distanceKm', 'durationMin', 'riderRating'])) ||
        // Rider rates the driver once, after completion
        (isAuthenticated() &&
          resource.data.riderId == request.auth.uid &&
          resource.data.get('completedAt', null) != null &&
          resource.data.get('driverRating', null) == null &&
          onlyUpdating(['driverRating']) &&
          request.resource.data.driverRating is number &&
          request.resource.data.driverRating >= 1 &&
          request.resource.data.driverRating <= 5);

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /companies/{companyId} — corporate accounts. All writes go through the
    // createCompany / updateCompany / *CompanyMember Cloud Functions.
    // -------------------------------------------------------------------------

    match /companies/{companyId} {
      allow read:  if isAdmin() || isCompanyMember(companyId);
      allow write: if false;

      match /members/{memberId} {
        allow read:  if isAdmin() || isOwner(memberId) || isCompanyAdminOf(companyId);
        allow write: if false;
      }
    }

    // Pending invites, keyed by e-mail, claimed when that person signs up.
    match /companyInvites/{email} {
      allow read:  if isAdmin() || (isAuthenticated() && isCompanyAdminOf(resource.data.companyId));
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /supportTickets/{ticketId} — a rider or chauffeur talks to the Luxelane
    // team. onSupportMessageCreated keeps the summary fields up to date.
    // -------------------------------------------------------------------------

    function supportCategories() {
      return ['trip', 'lostItem', 'billing', 'chauffeur', 'safety', 'app', 'other'];
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['userId', 'userName', 'userRole', 'category', 'subject',
          'bookingId', 'status', 'priority', 'createdAt', 'updatedAt', 'lastMessageAt',
          'lastMessagePreview', 'lastAuthorRole', 'unreadForUser', 'unreadForAdmin']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userRole == getUserRole() &&
        request.resource.data.category in supportCategories() &&
        request.resource.data.status == 'open' &&
        // Summary fields start as the server would set them (opsWatch reads them).
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.lastMessageAt == request.time &&
        request.resource.data.lastAuthorRole == 'user' &&
        request.resource.data.unreadForUser == false &&
        request.resource.data.unreadForAdmin == true &&
        request.resource.data.userName is string && request.resource.data.userName.size() <= 120 &&
        request.resource.data.lastMessagePreview is string && request.resource.data.lastMessagePreview.size() <= 140 &&
        ((request.resource.data.category == 'safety' && request.resource.data.priority == 'urgent') ||
         (request.resource.data.category != 'safety' && request.resource.data.priority == 'normal')) &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 120 &&
        // A linked trip must be one of the caller's own.
        (request.resource.data.get('bookingId', null) == null ||
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.riderId == request.auth.uid ||
          get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.driverId == request.auth.uid);

      allow update: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid && (
          // Mark the team's reply as read
          (onlyUpdating(['unreadForUser']) && request.resource.data.unreadForUser == false) ||
          // Close the request
          (onlyUpdating(['status', 'updatedAt']) && request.resource.data.status == 'resolved')
        ));
      allow delete: if false;

      match /messages/{messageId} {
        function ticketAfter() {
          return getAfter(/databases/$(database)/documents/supportTickets/$(ticketId)).data;
        }
        allow read: if isAdmin() ||
          (isAuthenticated() &&
            get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId == request.auth.uid);
        allow create: if isAuthenticated() &&
          request.resource.data.keys().hasOnly(['authorId', 'authorRole', 'authorName', 'text', 'createdAt']) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 &&
          ((request.resource.data.authorRole == 'user' && ticketAfter().userId == request.auth.uid) ||
           (request.resource.data.authorRole == 'admin' && isAdmin()));
        allow update, delete: if false;
      }
    }

    // -------------------------------------------------------------------------
    // Observability — grouped app errors and the monitor's health summary.
    // Written only by Cloud Functions (reportClientError, opsWatch).
    // -------------------------------------------------------------------------

    match /clientErrors/{fingerprint} {
      allow read:   if isAdmin();
      // Admins only toggle the resolved flag.
      allow update: if isAdmin() && onlyUpdating(['resolved']);
      allow create, delete: if false;
    }

    match /system/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /promoCodes/{code} — managed with the savePromoCode Cloud Function and
    // redeemed only by createBooking. Riders never list codes.
    // -------------------------------------------------------------------------

    match /promoCodes/{code} {
      allow read:  if isAdmin();
      allow write: if false;

      match /redemptions/{uid} {
        allow read:  if isAdmin();
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // /payments/{paymentId} — written only by Cloud Functions / admins
    // -------------------------------------------------------------------------

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid || isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /vehicles/{vehicleId}
    // -------------------------------------------------------------------------

    match /vehicles/{vehicleId} {
      allow read:   if isAuthenticated();
      allow create: if isAdmin() ||
        (isDriver() && isOwner(request.resource.data.driverId));
      allow update: if isAdmin() || (
        isDriver() &&
        resource.data.driverId == request.auth.uid &&
        onlyUpdating(['color', 'photoUrl'])
      );
      allow delete: if isAdmin();
    }

    // Vehicle catalog: public (the website shows the fleet); written only by
    // the saveVehicleClass callable, which validates every field.
    match /vehicleClasses/{classId} {
      allow read: if true;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /pricingRules/{ruleId}
    // Tarifas públicas (la web las muestra sin sesión); solo el admin las
    // edita, con importes numéricos no negativos.
    // -------------------------------------------------------------------------

    function validFare(d) {
      return d.basePriceUsd is number && d.basePriceUsd >= 0 &&
        d.pricePerKmUsd is number && d.pricePerKmUsd >= 0 &&
        d.pricePerHourUsd is number && d.pricePerHourUsd >= 0 &&
        d.minimumPriceUsd is number && d.minimumPriceUsd >= 0 &&
        d.get('isActive', true) is bool;
    }

    match /pricingRules/{ruleId} {
      allow read:   if true;
      allow create, update: if isAdmin() && validFare(request.resource.data);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Admin-only collections
    // -------------------------------------------------------------------------

    match /admin_logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }

    match /config/{docId} {
      // The commission is for admins and chauffeurs (their settlement), not riders.
      // config/global (maintenance, minimum app builds) is public: the apps
      // check it before anyone signs in.
      allow read:  if docId == 'global' ||
        (isAuthenticated() && (docId != 'finance' || isAdmin() || isDriver()));
      // finance: `commissionPct` (settlements) and `platformCommissionPct`
      // (booking settlement split) are each validated when present.
      allow write: if isAdmin() && (docId != 'finance' || ((
        !('commissionPct' in request.resource.data) || (
          request.resource.data.commissionPct is number &&
          request.resource.data.commissionPct >= 0 &&
          request.resource.data.commissionPct <= 50)) && (
        !('platformCommissionPct' in request.resource.data) || (
          request.resource.data.platformCommissionPct is number &&
          request.resource.data.platformCommissionPct >= 0 &&
          request.resource.data.platformCommissionPct <= 100)))) && (docId != 'loyalty' || (
        // The server re-validates every tier (functions/src/loyalty.ts).
        request.resource.data.enabled is bool &&
        request.resource.data.tiers is list &&
        request.resource.data.tiers.size() <= 3)) && (docId != 'support' || request.method == 'delete' || (
        request.resource.data.keys().hasOnly(['days', 'openMin', 'closeMin']) &&
        request.resource.data.days is list &&
        request.resource.data.days.size() >= 1 &&
        request.resource.data.days.size() <= 7 &&
        request.resource.data.openMin is int &&
        request.resource.data.closeMin is int &&
        request.resource.data.openMin >= 0 &&
        request.resource.data.closeMin <= 1440 &&
        request.resource.data.openMin < request.resource.data.closeMin)) && (docId != 'global' || (
        // Legacy keys (push, 2FA) stay allowed so merges of old docs work.
        request.resource.data.keys().hasOnly(['isMaintenanceMode', 'riderMinBuild', 'driverMinBuild',
          'riderIosUrl', 'driverIosUrl', 'updatedAt', 'pushNotificationsEnabled', 'twoFactorEnabled',
          'firstClassEnabled']) &&
        request.resource.data.get('firstClassEnabled', false) is bool &&
        request.resource.data.get('isMaintenanceMode', false) is bool &&
        request.resource.data.get('riderMinBuild', 0) is int &&
        request.resource.data.get('driverMinBuild', 0) is int &&
        request.resource.data.get('riderMinBuild', 0) >= 0 &&
        request.resource.data.get('driverMinBuild', 0) >= 0 &&
        request.resource.data.get('riderIosUrl', '') is string &&
        request.resource.data.get('driverIosUrl', '') is string &&
        (request.resource.data.get('riderIosUrl', '') == '' ||
          request.resource.data.riderIosUrl.matches('https://apps[.]apple[.]com/.{1,200}')) &&
        (request.resource.data.get('driverIosUrl', '') == '' ||
          request.resource.data.driverIosUrl.matches('https://apps[.]apple[.]com/.{1,200}'))));
    }

    // -------------------------------------------------------------------------
    // /businessLeads/{id} — solicitudes de empresas (sin cuenta). Se crean
    // con campos acotados; solo el admin las lee y las marca atendidas.
    // -------------------------------------------------------------------------

    function shortText(v, max) {
      return v is string && v.size() <= max;
    }

    match /businessLeads/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['company', 'contactName',
          'email', 'phone', 'travellers', 'message', 'handled', 'createdAt']) &&
        shortText(request.resource.data.company, 120) &&
        request.resource.data.company.size() > 0 &&
        shortText(request.resource.data.contactName, 120) &&
        shortText(request.resource.data.email, 160) &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        shortText(request.resource.data.phone, 40) &&
        shortText(request.resource.data.travellers, 20) &&
        shortText(request.resource.data.message, 2000) &&
        request.resource.data.handled == false &&
        request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin() && onlyUpdating(['handled']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /refunds/{refundId} — money given back for a ride, recorded by admins
    // through the recordRefund Cloud Function. Riders see their own.
    // -------------------------------------------------------------------------

    match /refunds/{refundId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.riderId == request.auth.uid);
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // /hotels/{hotelId} — partner hotels for hotel transfers. Active ones are
    // public (the page works for guests); admins manage them.
    // -------------------------------------------------------------------------

    match /hotels/{hotelId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin() &&
        request.resource.data.keys().hasOnly(['name', 'address', 'lat', 'lng', 'meetingPoint', 'active', 'updatedAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.address is string &&
        request.resource.data.lat is number &&
        request.resource.data.lng is number &&
        request.resource.data.meetingPoint is string &&
        request.resource.data.meetingPoint.size() <= 120 &&
        request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // /settlements/{driverId_week} — weeks an admin marked as settled with a
    // chauffeur. Chauffeurs see their own.
    // -------------------------------------------------------------------------

    match /settlements/{recordId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.driverId == request.auth.uid);
      allow create, update: if isAdmin() &&
        recordId.matches(request.resource.data.driverId + '_[0-9]{8}') &&
        request.resource.data.balance is number &&
        request.resource.data.paidBy == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
