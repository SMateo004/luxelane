rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers — role is stored in /users/{uid}.role in Firestore
    // -------------------------------------------------------------------------

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && getUserRole() == 'admin';
    }

    function isDriver() {
      return request.auth != null && getUserRole() == 'driver';
    }

    function isRider() {
      return request.auth != null && getUserRole() == 'rider';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // El admin bloquea cuentas con isActive = false.
    function isActiveUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
        .data.get('isActive', true) == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function onlyUpdating(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // -------------------------------------------------------------------------
    // /users/{uid}
    // -------------------------------------------------------------------------

    // Privileged fields: only an admin (or the Admin SDK in Cloud Functions,
    // which bypasses these rules) may set or change them. Nobody can make
    // themselves admin or driver from the client.
    function privilegedUserFields() {
      return ['role', 'isActive', 'stripeCustomerId'];
    }

    // A self-created profile is always an active rider with no Stripe link.
    function isValidSelfSignup(uid) {
      let d = request.resource.data;
      return d.role == 'rider' &&
        d.get('isActive', true) == true &&
        d.get('stripeCustomerId', null) == null &&
        d.get('id', uid) == uid;
    }

    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || (isOwner(uid) && isValidSelfSignup(uid));
      allow update: if isAdmin() || (
        isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(privilegedUserFields())
      );
      allow delete: if false;
    }

    // In-app notifications: each user reads and marks their own as read.
    match /users/{uid}/notifications/{notificationId} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) || isAdmin();
      allow update: if (isOwner(uid) &&
        onlyUpdating(['isRead'])) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // /driverProfiles/{uid}
    // -------------------------------------------------------------------------

    match /driverProfiles/{uid} {
      allow read:   if isAuthenticated();
      allow create: if isOwner(uid) && isDriver();
      allow update: if (isOwner(uid) && isDriver()) || isAdmin();
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /bookings/{bookingId}
    // -------------------------------------------------------------------------

    // Pasos que un chófer puede dar sobre su reserva (igual que
    // AdminOperations en la app). Repetir el estado actual solo toca updatedAt.
    function isDriverStep(from, to) {
      return to == from ||
        (from == 'confirmed' && to == 'driver_arriving') ||
        (from == 'driver_arriving' && to == 'driver_arrived') ||
        (from == 'driver_arrived' && to == 'in_progress') ||
        (from == 'in_progress' && to == 'completed');
    }

    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        (resource.data.status == 'pending' && isDriver()) ||
        isAdmin()
      );

      // Any authenticated user can create a booking for themselves
      // El reparto y la revisión de tarifa solo los escribe el servidor.
      allow create: if isAuthenticated() &&
        isActiveUser() &&
        request.resource.data.riderId == request.auth.uid &&
        !('settlement' in request.resource.data) &&
        !('pricingReview' in request.resource.data) &&
        !('refunded' in request.resource.data);

      allow update: if isAdmin() ||
        // Driver accepts a pending booking (self-assign)
        (isDriver() && isActiveUser() &&
          resource.data.status == 'pending' &&
          request.resource.data.driverId == request.auth.uid &&
          request.resource.data.status == 'confirmed' &&
          onlyUpdating(['driverId', 'status', 'updatedAt'])) ||
        // Driver progresses their assigned booking, one step at a time
        (isDriver() &&
          resource.data.driverId == request.auth.uid &&
          onlyUpdating(['status', 'updatedAt']) &&
          isDriverStep(resource.data.status, request.resource.data.status)) ||
        // Rider cancels their own booking before the trip starts
        (isAuthenticated() &&
          resource.data.riderId == request.auth.uid &&
          onlyUpdating(['status', 'updatedAt']) &&
          resource.data.status in
            ['pending', 'confirmed', 'driver_arriving', 'driver_arrived'] &&
          request.resource.data.status == 'cancelled');

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /rides/{rideId}
    // -------------------------------------------------------------------------

    match /rides/{rideId} {
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAdmin();

      allow update: if isAdmin() || (
        isAuthenticated() &&
        isDriver() &&
        resource.data.driverId == request.auth.uid &&
        onlyUpdating([
          'driverRoute',
          'completedAt',
          'distanceKm',
          'durationMin',
          'riderRating',
          'driverRating'
        ])
      );

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /payments/{paymentId}
    // -------------------------------------------------------------------------

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.riderId == request.auth.uid || isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /vehicles/{vehicleId}
    // -------------------------------------------------------------------------

    match /vehicles/{vehicleId} {
      allow read:   if isAuthenticated();
      allow create: if isAdmin() ||
        (isDriver() && isOwner(request.resource.data.driverId));
      allow update: if isAdmin() || (
        isDriver() &&
        resource.data.driverId == request.auth.uid &&
        onlyUpdating(['isActive', 'color', 'photoUrl'])
      );
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // /pricingRules/{ruleId}
    // Tarifas públicas (la web las muestra sin sesión); solo el admin las
    // edita, con importes numéricos no negativos.
    // -------------------------------------------------------------------------

    function validFare(d) {
      return d.basePriceUsd is number && d.basePriceUsd >= 0 &&
        d.pricePerKmUsd is number && d.pricePerKmUsd >= 0 &&
        d.pricePerHourUsd is number && d.pricePerHourUsd >= 0 &&
        d.minimumPriceUsd is number && d.minimumPriceUsd >= 0 &&
        d.isActive is bool;
    }

    match /pricingRules/{ruleId} {
      allow read:   if true;
      allow create, update: if isAdmin() && validFare(request.resource.data);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // /config/{docId}
    // global: estado operativo (mantenimiento) que lee la app del pasajero.
    // finance: comisión y parámetros internos, solo para el admin.
    // -------------------------------------------------------------------------

    match /config/{docId} {
      allow read:  if docId == 'global' || isAdmin();
      allow write: if isAdmin() && (
        docId != 'finance' ||
        !('platformCommissionPct' in request.resource.data) || (
          request.resource.data.platformCommissionPct is number &&
          request.resource.data.platformCommissionPct >= 0 &&
          request.resource.data.platformCommissionPct <= 100
        )
      );
    }

    // -------------------------------------------------------------------------
    // /admin_logs/{logId}  — auditoría inmutable
    // -------------------------------------------------------------------------

    match /admin_logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
