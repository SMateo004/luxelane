{
  "name": "luxelane-functions",
  "scripts": {
    "build": "tsc",
    "test": "jest --passWithNoTests",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "migrate:booking-pii": "npm run build && node scripts/migrate-booking-pii.js",
    "migrate:event-details": "npm run build && node scripts/migrate-event-details.js",
    "migrate:pricing-updated-by": "npm run build && node scripts/migrate-pricing-updated-by.js",
    "backfill:role-claims": "npm run build && node scripts/backfill-role-claims.js",
    "promote:admin": "npm run build && node ../scripts/promote_admin.mjs",
    "trips:in-flight": "npm run build && node scripts/trips-in-flight.js"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "stripe": "^16.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js"
    ]
  },
  "engines": {
    "node": "22"
  },
  "private": true
}
